# Only send files used by the Web Dockerfile and the Next.js build.
/*
!/.dockerignore
!/package.json
!/package-lock.json
!/apps/
/apps/*
!/apps/web/
/apps/web/*
!/apps/web/Dockerfile
!/apps/web/package.json
!/apps/web/tsconfig.json
!/apps/web/next.config.mjs
!/apps/web/next-env.d.ts
!/apps/web/scripts/
/apps/web/scripts/*
!/apps/web/scripts/prepare-standalone.mjs
!/apps/web/scripts/run-member-map.mjs
!/apps/web/scripts/live-map/
!/apps/web/scripts/live-map/**
!/apps/web/scripts/map-classification/
!/apps/web/scripts/map-classification/vertex.mjs
!/tests/
!/tests/fixtures/
!/tests/fixtures/meetmap/
!/tests/fixtures/meetmap/classification.v1.json
!/tests/fixtures/meetmap/venue-selection.ja.jsonl
!/tests/fixtures/meetmap/venue-selection.u16.graph.json
!/apps/web/src/
!/apps/web/src/**
!/apps/web/public/
!/apps/web/public/**
**/node_modules/
**/.env*
**/*.pem
**/*.key
**/*service-account*.json
**/gha-creds-*.json
**/*.md
