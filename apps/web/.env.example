# Optional. Allowed values: info, warn, error. Defaults to info.
APP_LOG_LEVEL=info

# Google sign-in. Copy the four public values from your Firebase Web app's SDK
# configuration to .env.local, or set them on the running Web service.
# GOOGLE_CLOUD_PROJECT=
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_WEB_APP_ID=

# Local HTTPS demo only. Proxy the emulator sign-in endpoints on the same origin.
# Requires a demo-* project and loopback Auth and Firestore emulators.
# FIREBASE_AUTH_EMULATOR_SAME_ORIGIN=1

# NODE_ENV is set by Next.js; do not override it here.
# The Firestore/Functions and SQL Connect checks supply GOOGLE_CLOUD_PROJECT
# and a temporary DB_CHECK_TOKEN. Normal startup needs neither setting.
# User profile registration and live DB checks use Application Default Credentials (ADC).
# Never put secrets in variables prefixed with NEXT_PUBLIC_.

# Optional, operator-only /voice-probe. Use a random secret of at least 32 characters.
VOICE_PROBE_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to 1 to enable authenticated member-room audio with the room voice worker.
MEETING_VOICE_ENABLED=0

# Private meeting context API. Allow only this worker service account and audience.
# MEETING_WORKER_EMAIL=
# MEETING_WORKER_AUDIENCE=https://your-web-service.run.app

# Optional for the live map server. Without a key Exa applies its free MCP rate limit.
# EXA_API_KEY=
