# Configuration check and local voice tools.
APP_ENV=development
LOG_LEVEL=INFO

# make voice-worker: the same LiveKit project as the web server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used by all three voice tools.
GOOGLE_CLOUD_PROJECT=
# Use ADC (local login or attached service account). If using a credential file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repository.json

# Reply model and thinking for all three voice tools. The worker accepts these two
# models; restart it after changing either value. "default" sends no thinking
# setting, which is how Flash-Lite was fast on 2026-11-08.
# GEMINI_MODEL=gemini-3.8-flash
# Alternative: gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# Alternatives: default, medium, high

# Optional overrides for voice-check and live-check only.
# SPEECH_LOCATION=us
# SPEECH_MODEL=chirp_3
# GEMINI_LOCATION=global
# GEMINI_TTS_LOCATION=us
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore

# Member meeting worker's authenticated, read-only Web API (HTTPS or local loopback).
# MEETING_WEB_ORIGIN=https://your-web-service.run.app
# MEETING_WORKER_AUDIENCE=https://your-web-service.run.app
# Optional for local user ADC with permission to impersonate the worker:
# MEETING_WORKER_IMPERSONATE=

# Public web search in member meetings (Tavily); keep this key on the worker.
# TAVILY_API_KEY=

# Concurrent member-room jobs per registered server (1 to 10; default 1).
# MEETING_MAX_ROOMS_PER_WORKER=5
